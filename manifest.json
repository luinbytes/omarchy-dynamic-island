{
  "schemaVersion": 1,
  "id": "luinbytes.island",
  "name": "Omarchy Island",
  "version": "0.1.0",
  "author": "luinbytes",
  "description": "Quickbar activity surface for live system state",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "shell/plugins/island/Service.qml",
    "barWidget": "shell/plugins/island/BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Omarchy Island",
    "description": "Live activity status attached to the quickbar",
    "category": "Status",
    "defaultSection": "center",
    "allowMultiple": false
  }
}
